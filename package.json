{
  "name": "toolmd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build-sitemap.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p cloudflare/collab-worker/tsconfig.json --noEmit && tsc -p cloudflare/mcp-worker/tsconfig.json --noEmit",
    "seo:sitemap": "tsx scripts/build-sitemap.ts",
    "mcp:deploy": "wrangler deploy cloudflare/mcp-worker/index.ts --name toolmd-mcp --config cloudflare/mcp-worker/wrangler.toml --keep-vars",
    "mcp:deploy:dry-run": "wrangler deploy cloudflare/mcp-worker/index.ts --name toolmd-mcp --config cloudflare/mcp-worker/wrangler.toml --keep-vars --dry-run",
    "mcp:smoke:http": "tsx mcp/http-smoke.ts",
    "collab:dev": "wrangler dev --config cloudflare/collab-worker/wrangler.toml",
    "collab:deploy": "wrangler deploy --config cloudflare/collab-worker/wrangler.toml"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.5.0",
    "@hocuspocus/server": "^4.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^1.28.0",
    "markdown-it": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "yaml": "^2.9.0",
    "yjs": "13.6.32",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.6",
    "wrangler": "^4.118.0"
  }
}
